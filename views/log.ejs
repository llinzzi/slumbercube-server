<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>API 日志 · 192电台</title>
  <style>
    :root {
      --bg: #0d0f14; --surface: #15181f; --surface2: #1c2029;
      --border: #2a2f3a; --text: #d4d8e0; --text-dim: #6b7280;
      --accent: #22c55e; --err: #ef4444; --warn: #f59e0b;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'SF Mono', Monaco, 'Cascadia Code', monospace;
      background: var(--bg); color: var(--text); font-size: 12px;
      padding: 16px; line-height: 1.5;
    }
    .container { max-width: 1200px; margin: 0 auto; }
    h1 { font-size: 18px; margin-bottom: 12px; color: var(--accent); }
    .toolbar {
      display: flex; gap: 8px; margin-bottom: 12px;
      align-items: center; flex-wrap: wrap;
    }
    .toolbar input, .toolbar select {
      background: var(--surface); color: var(--text);
      border: 1px solid var(--border); border-radius: 4px;
      padding: 4px 8px; font-size: 11px; font-family: inherit;
    }
    .toolbar .count { font-size: 11px; color: var(--text-dim); }
    .btn {
      background: var(--surface2); color: var(--text);
      border: 1px solid var(--border); border-radius: 4px;
      padding: 4px 10px; cursor: pointer; font-size: 11px;
      font-family: inherit; transition: all 0.1s;
    }
    .btn:hover { border-color: var(--accent); color: var(--accent); }
    .log-entry {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 6px; margin-bottom: 4px; overflow: hidden;
    }
    .log-head {
      display: grid;
      grid-template-columns: 80px 50px 130px 1fr 60px;
      gap: 8px; padding: 6px 10px; cursor: pointer;
      align-items: center; font-size: 11px;
      transition: background 0.1s;
    }
    .log-head:hover { background: var(--surface2); }
    .log-head .ts { color: var(--text-dim); font-size: 10px; }
    .log-head .method {
      font-weight: 700; text-transform: uppercase;
      color: var(--accent);
    }
    .log-head .method.get { color: #60a5fa; }
    .log-head .method.post { color: #f59e0b; }
    .log-head .url { color: var(--text); word-break: break-all; }
    .log-head .ip { color: var(--text-dim); font-size: 10px; font-family: monospace; }
    .log-head .status {
      text-align: right; font-weight: 700;
    }
    .log-head .status.\32 00 { color: var(--accent); }
    .log-head .status.\33 00, .log-head .status.\33 01, .log-head .status.\33 02 { color: var(--warn); }
    .log-head .status.\34 00, .log-head .status.\34 04 { color: var(--warn); }
    .log-head .status.\35 00 { color: var(--err); }
    .log-body { display: none; padding: 8px 10px; border-top: 1px solid var(--border); }
    .log-body.open { display: block; }
    .log-body pre {
      font-size: 10px; background: #0a0c10;
      padding: 8px; border-radius: 4px;
      overflow-x: auto; white-space: pre-wrap; word-break: break-all;
      max-height: 300px; overflow-y: auto; margin-bottom: 6px;
    }
    .log-body .label {
      font-size: 10px; color: var(--text-dim);
      margin-bottom: 4px; font-weight: 600;
    }
    .log-body .meta-row {
      display: flex; gap: 12px; font-size: 10px;
      color: var(--text-dim); margin-bottom: 6px;
    }
    .empty { text-align: center; padding: 40px; color: var(--text-dim); }
  </style>
</head>
<body>
<div class="container">
  <%- include("partials/_nav") %>
<h1>📋 API 日志</h1>
  <div class="toolbar">
    <input id="filter-url" placeholder="筛选 URL..." />
    <select id="filter-method">
      <option value="">全部方法</option>
      <option value="GET">GET</option>
      <option value="POST">POST</option>
    </select>
    <select id="filter-status">
      <option value="">全部状态</option>
      <option value="2">2xx</option>
      <option value="3">3xx</option>
      <option value="4">4xx</option>
      <option value="5">5xx</option>
    </select>
    <select id="filter-ip"><option value="">全部 IP</option></select>
    <label style="display:flex;align-items:center;gap:4px;font-size:11px;">
      <input type="checkbox" id="auto-refresh" checked /> 自动刷新
    </label>
    <button class="btn" id="clear-btn">🗑️ 清空</button>
    <span class="count" id="log-count">0 条</span>
  </div>
  <div id="log-list"></div>
</div>
<script>
const logList = document.getElementById('log-list');
const filterUrl = document.getElementById('filter-url');
const filterMethod = document.getElementById('filter-method');
const filterStatus = document.getElementById('filter-status');
const filterIp = document.getElementById('filter-ip');
const autoRefresh = document.getElementById('auto-refresh');
const logCount = document.getElementById('log-count');
let entries = [];
let expanded = new Set();

function escapeHtml(s) {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

function fmtBody(raw, trunc) {
  if (!raw) return '(empty)';
  try {
    const parsed = JSON.parse(raw);
    return JSON.stringify(parsed, null, 2);
  } catch (e) {
    return raw;
  }
}

function render() {
  const urlF = filterUrl.value.toLowerCase();
  const methodF = filterMethod.value;
  const statusF = filterStatus.value;
  const ipF = filterIp.value;

  const filtered = entries.filter(e => {
    if (urlF && !e.url.toLowerCase().includes(urlF)) return false;
    if (methodF && e.method !== methodF) return false;
    if (statusF && String(e.status).charAt(0) !== statusF) return false;
    if (ipF && (e.ip || '') !== ipF) return false;
    return true;
  });

  if (!filtered.length) {
    logList.innerHTML = '<div class="empty">暂无日志</div>';
    logCount.textContent = entries.length + ' 条 (显示 0)';
    return;
  }

  logList.innerHTML = filtered.map(e => {
    const isOpen = expanded.has(e.id) ? ' open' : '';
    const bodyStr = typeof e.body === 'string' ? e.body : (e.body ? JSON.stringify(e.body) : '');
    const respStr = e.response ? (typeof e.response.body === 'string' ? e.response.body : JSON.stringify(e.response.body)) : '';
    const truncated = e.response ? e.response.truncated : false;

    // Hide sensitive fields
    const safeBody = bodyStr ? (bodyStr.length > 3000 ? bodyStr.slice(0, 3000) + '\\n... (截断)' : bodyStr) : '';
    const safeResp = respStr ? (respStr.length > 3000 ? respStr.slice(0, 3000) + '\\n... (截断)' : respStr) : '';

    return '<div class="log-entry">'
      + '<div class="log-head" onclick="toggle(' + e.id + ')">'
      + '<span class="ts">' + escapeHtml(e.ts.slice(5, 19)) + '</span>'
      + '<span class="method ' + e.method.toLowerCase() + '">' + e.method + '</span>'
      + '<span class="ip">' + escapeHtml(e.ip || '') + '</span>'
      + '<span class="url">' + escapeHtml(e.url) + '</span>'
      + '<span class="status ' + e.status + '">' + e.status + '</span>'
      + '</div>'
      + '<div class="log-body' + isOpen + '">'
      + '<div class="meta-row"><span>⏱ ' + escapeHtml(e.ts) + '</span></div>'
      + (safeBody ? '<div class="label">📤 请求体</div><pre>' + escapeHtml(fmtBody(safeBody, false)) + '</pre>' : '')
      + (safeResp ? '<div class="label">📥 响应体 (' + e.status + ')</div><pre>' + escapeHtml(fmtBody(safeResp, false)) + '</pre>' : '')
      + (truncated ? '<div class="meta-row"><span>⚠ 响应体超过 2000 字符，已截断</span></div>' : '')
      + '</div></div>';
  }).join('');
  logCount.textContent = entries.length + ' 条 (显示 ' + filtered.length + ')';
}

function toggle(id) {
  if (expanded.has(id)) expanded.delete(id); else expanded.add(id);
  render();
}

async function load() {
  try {
    const r = await fetch('/api/log');
    const d = await r.json();
    entries = d.entries || [];
    render();
  } catch (e) {
    // ignore
  }
}

filterUrl.addEventListener('input', render);
filterMethod.addEventListener('change', render);
filterStatus.addEventListener('change', render);
filterIp.addEventListener('change', render);

function populateIpDropdown() {
  var prev = filterIp.value;
  var ips = {};
  entries.forEach(function(e) { if (e.ip) ips[e.ip] = true; });
  var keys = Object.keys(ips).sort();
  filterIp.innerHTML = '<option value="">全部 IP</option>';
  keys.forEach(function(ip) {
    var opt = document.createElement('option');
    opt.value = ip; opt.textContent = ip;
    filterIp.appendChild(opt);
  });
  // Restore previous selection if still present
  if (prev && ips[prev]) filterIp.value = prev;
  render();
}

// Override load to also populate IP dropdown
var origLoad = load;
load = function() {
  return origLoad().then(function() { populateIpDropdown(); });
};
document.getElementById('clear-btn').addEventListener('click', async () => {
  await fetch('/api/log/clear', { method: 'POST' });
  entries = []; expanded.clear(); render();
});

load();
if (autoRefresh.checked) setInterval(load, 3000);
autoRefresh.addEventListener('change', function() {
  if (this.checked) { load(); setInterval(load, 3000); }
});
</script>
</body>
</html>