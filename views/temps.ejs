<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>温湿度图表 · 192电台</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@3.0.0/dist/chartjs-adapter-date-fns.bundle.min.js"></script>
  <style>
    :root {
      --bg: #0d0f14; --surface: #15181f; --surface2: #1c2029;
      --border: #2a2f3a; --text: #d4d8e0; --text-dim: #6b7280;
      --accent: #22c55e; --temp: #f97316; --hum: #38bdf8;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: var(--bg); color: var(--text); padding: 20px; font-size: 13px;
    }
    .container { max-width: 1100px; margin: 0 auto; }
    h1 { font-size: 20px; margin-bottom: 16px; color: var(--accent); }
    h1 small { color: var(--text-dim); font-weight: 400; font-size: 12px; margin-left: 8px; }

    .nav { margin-bottom: 16px; }
    .nav a { color: var(--text-dim); text-decoration: none; font-size: 12px; margin-right: 14px; }
    .nav a:hover { color: var(--accent); }

    /* --- Device list (left) + chart (right) --- */
    .layout { display: grid; grid-template-columns: 220px 1fr; gap: 16px; }

    .device-panel {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 8px; padding: 14px;
      align-self: start; position: sticky; top: 16px;
    }
    .device-panel h3 { font-size: 12px; color: var(--text-dim); margin-bottom: 10px; font-weight: 500; }
    .device-list { display: flex; flex-direction: column; gap: 6px; }
    .device-item {
      display: flex; align-items: center; gap: 8px; padding: 6px 8px;
      background: var(--bg); border: 1px solid var(--border); border-radius: 6px;
      cursor: pointer; transition: border-color 0.1s;
    }
    .device-item:hover { border-color: var(--text-dim); }
    .device-item.active { border-color: var(--accent); background: var(--surface2); }
    .device-item .dot { width: 12px; height: 12px; border-radius: 50%; flex-shrink: 0; }
    .device-item .name { font-family: monospace; font-size: 12px; flex: 1; overflow: hidden; text-overflow: ellipsis; }
    .device-item .count { color: var(--text-dim); font-size: 10px; font-family: monospace; }
    .device-panel .meta {
      margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--border);
      font-size: 10px; color: var(--text-dim); line-height: 1.5;
    }
    .device-panel .meta strong { color: var(--text); font-weight: 500; }

    /* --- Right panel: chart + table --- */
    .right-panel { display: flex; flex-direction: column; gap: 16px; }

    .toolbar {
      display: flex; gap: 8px; align-items: center;
      background: var(--surface); padding: 10px 14px;
      border-radius: 8px; border: 1px solid var(--border);
      flex-wrap: wrap;
    }
    .toolbar .group { display: flex; align-items: center; gap: 6px; }
    .toolbar label { font-size: 11px; color: var(--text-dim); }
    .toolbar select {
      background: var(--bg); color: var(--text); border: 1px solid var(--border);
      border-radius: 4px; padding: 4px 8px; font-size: 11px; font-family: inherit;
    }
    .toolbar button {
      background: var(--surface2); color: var(--text); border: 1px solid var(--border);
      border-radius: 4px; padding: 4px 12px; font-size: 11px; cursor: pointer;
    }
    .toolbar button:hover { border-color: var(--accent); color: var(--accent); }

    .tabs { display: flex; gap: 0; background: var(--surface); border-radius: 8px 8px 0 0;
            border: 1px solid var(--border); border-bottom: none; padding: 0 12px; }
    .tab {
      padding: 10px 18px; font-size: 12px; cursor: pointer;
      border-bottom: 2px solid transparent; color: var(--text-dim);
    }
    .tab.active { color: var(--temp); border-bottom-color: var(--temp); }
    .tab[data-metric="humidity"].active { color: var(--hum); border-bottom-color: var(--hum); }

    .chart-card {
      background: var(--surface); border: 1px solid var(--border); border-top: none;
      border-radius: 0 0 8px 8px; padding: 16px; height: 380px; position: relative;
    }
    .chart-card canvas { max-width: 100%; max-height: 100%; }

    /* --- Stat strip (one row) --- */
    .stat-strip { display: flex; gap: 10px; }
    .stat {
      flex: 1; background: var(--surface); border: 1px solid var(--border);
      border-radius: 8px; padding: 10px 14px;
    }
    .stat .label { font-size: 10px; color: var(--text-dim); text-transform: uppercase; }
    .stat .value { font-size: 18px; font-weight: 700; margin-top: 2px; font-family: monospace; }
    .stat .value .unit { font-size: 11px; color: var(--text-dim); margin-left: 2px; font-weight: 400; }

    /* --- Detail table at bottom --- */
    .table-card {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 8px; padding: 14px;
    }
    .table-card h3 {
      font-size: 12px; color: var(--text-dim); margin-bottom: 10px; font-weight: 500;
    }
    table { width: 100%; border-collapse: collapse; font-size: 11px; font-family: monospace; }
    th { text-align: left; color: var(--text-dim); padding: 6px 8px; border-bottom: 1px solid var(--border); font-weight: 500; }
    td { padding: 6px 8px; border-bottom: 1px solid var(--border); }
    tr:last-child td { border-bottom: none; }
    td.dot-cell { width: 14px; }
    td.num { text-align: right; color: var(--text); }
    td.time { color: var(--text-dim); }

    .empty { text-align: center; padding: 40px; color: var(--text-dim); font-size: 12px; }
    .help { font-size: 10px; color: var(--text-dim); margin-top: 4px; line-height: 1.5; }
  </style>
</head>
<body>
<div class="container">
  <div class="nav">
    <a href="/">← 电台首页</a>
    <a href="/admin/dj">🎛 92DJ</a>
    <a href="/library">📀 曲目库</a>
    <a href="/log">📋 日志</a>
  </div>
  <h1>🌡️ 温湿度图表 <small id="subtitle">按 IP 标识设备 · 跟 /log 一致</small></h1>

  <div class="layout">
    <!-- 左：设备面板（按 IP，跟 log 一致） -->
    <div class="device-panel">
      <h3>📡 设备（IP）</h3>
      <div class="device-list" id="device-list">
        <div class="empty" style="padding:20px;">加载中…</div>
      </div>
      <div class="meta">
        设备 ID = 客户端 IP（去掉 <strong>::ffff:</strong> 前缀）。<br>
        与 <a href="/log" style="color:var(--accent)">/log</a> 页一致。<br>
        仅显示最近 <strong>7 天</strong> 上传过数据的设备。
      </div>
    </div>

    <!-- 右：图 + 表 -->
    <div class="right-panel">
      <div class="toolbar">
        <div class="group">
          <label>时间窗</label>
          <select id="window-select">
            <option value="1">过去 1 小时</option>
            <option value="24" selected>过去 24 小时</option>
            <option value="168">过去 7 天</option>
            <option value="720">过去 30 天</option>
          </select>
        </div>
        <div class="group">
          <label>采样</label>
          <select id="bucket-select">
            <option value="0">原始</option>
            <option value="60" selected>1 分钟聚合</option>
            <option value="300">5 分钟聚合</option>
            <option value="3600">1 小时聚合</option>
          </select>
        </div>
        <button id="refresh-btn">🔄 刷新</button>
        <button id="test-btn">+ 模拟数据</button>
        <span style="flex:1;"></span>
        <span id="count-display" style="font-size:11px;color:var(--text-dim);"></span>
      </div>

      <div>
        <div class="tabs">
          <div class="tab active" data-metric="temperature">🌡 温度 (°C)</div>
          <div class="tab" data-metric="humidity">💧 湿度 (%)</div>
        </div>
        <div class="chart-card"><canvas id="chart"></canvas></div>
      </div>

      <div class="stat-strip" id="stat-strip"></div>

      <div class="table-card">
        <h3>📊 当前选中设备最近读数（最多 30 条）</h3>
        <table id="detail-table">
          <thead>
            <tr><th class="dot-cell"></th><th>时间</th><th class="num">温度 (°C)</th><th class="num">湿度 (%)</th><th>来源</th></tr>
          </thead>
          <tbody id="detail-body">
            <tr><td colspan="5" class="empty">选一个设备查看</td></tr>
          </tbody>
        </table>
      </div>

      <div class="help">
        设备上传：<code style="color:var(--accent);">GET /api/esp/&lt;id&gt;?temperature=X&humidity=Y</code>（设备在拉歌时附带传感器数据）。
        · 每设备最多保留 <strong>1440</strong> 条读数 · 颜色固定按 IP 字典序分配
      </div>
    </div>
  </div>
</div>

<script>
const COLORS = [
  '#22c55e', '#3b82f6', '#f59e0b', '#ef4444',
  '#a855f7', '#ec4899', '#14b8a6', '#f97316',
  '#06b6d4', '#84cc16', '#eab308', '#d946ef',
];

let state = {
  devices: [],     // [{id, color, count}]
  byDevice: {},    // device_id → [{ts, temperature, humidity, source}]
  selected: 'all', // 'all' | device_id
  metric: 'temperature',
  windowHours: 24,
  bucketSec: 60,
};

const $ = id => document.getElementById(id);

// Format timestamp compactly for tables
function fmtTime(iso) {
  const d = new Date(iso);
  const pad = n => String(n).padStart(2, '0');
  return `${pad(d.getMonth()+1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;
}

// Bucket aggregation: average readings in N-second windows per device
function bucketize(readings, bucketSec) {
  if (bucketSec <= 0) return readings;
  const buckets = new Map(); // key: `${dev}|${bucketStart}` → {sum, count, dev, ts}
  for (const r of readings) {
    const t = new Date(r.ts).getTime();
    const bucketStart = Math.floor(t / (bucketSec * 1000)) * (bucketSec * 1000);
    const key = `${r.device_id}|${bucketStart}`;
    const cur = buckets.get(key) || { device_id: r.device_id, ts: new Date(bucketStart).toISOString(),
                                       t_sum: 0, t_count: 0, h_sum: 0, h_count: 0 };
    if (r.temperature != null) { cur.t_sum += r.temperature; cur.t_count += 1; }
    if (r.humidity != null) { cur.h_sum += r.humidity; cur.h_count += 1; }
    buckets.set(key, cur);
  }
  const out = [];
  for (const v of buckets.values()) {
    out.push({
      device_id: v.device_id,
      ts: v.ts,
      temperature: v.t_count ? v.t_sum / v.t_count : null,
      humidity: v.h_count ? v.h_sum / v.h_count : null,
      source: 'bucket',
    });
  }
  out.sort((a, b) => a.ts.localeCompare(b.ts));
  return out;
}

async function loadDevices() {
  const r = await fetch('/api/devices/list');
  const d = await r.json();
  state.devices = d.devices.map((id, i) => ({ id, color: COLORS[i % COLORS.length], count: 0 }));
  renderDevicePanel();
}

async function loadReadings() {
  const hours = state.windowHours;
  const url = '/api/readings?days=' + Math.max(1, Math.ceil(hours / 24));
  const r = await fetch(url);
  const d = await r.json();
  // Filter to window
  const cutoff = Date.now() - hours * 3600 * 1000;
  const filtered = {};
  for (const [dev, list] of Object.entries(d.byDevice)) {
    const inWin = list.filter(x => new Date(x.ts).getTime() >= cutoff);
    if (inWin.length) filtered[dev] = inWin;
  }
  state.byDevice = filtered;
  // Update counts in device panel
  for (const dv of state.devices) dv.count = (filtered[dv.id] || []).length;
  renderDevicePanel();
  renderChart();
  renderStatStrip();
  renderDetailTable();
  const total = Object.values(filtered).reduce((s, l) => s + l.length, 0);
  $('count-display').textContent = total + ' 条 / ' + Object.keys(filtered).length + ' 设备';
}

function renderDevicePanel() {
  const el = $('device-list');
  if (!state.devices.length) {
    el.innerHTML = '<div class="empty" style="padding:20px;">7 天内无数据<br><small>点 "+模拟数据" 试试</small></div>';
    return;
  }
  let html = '<div class="device-item ' + (state.selected === 'all' ? 'active' : '') + '" data-id="all">'
    + '<div class="dot" style="background:linear-gradient(135deg,#3b82f6,#22c55e,#f59e0b)"></div>'
    + '<span class="name">全部设备</span>'
    + '<span class="count">' + state.devices.length + '</span></div>';
  for (const dv of state.devices) {
    html += '<div class="device-item ' + (state.selected === dv.id ? 'active' : '') + '" data-id="' + escapeHtml(dv.id) + '">'
      + '<div class="dot" style="background:' + dv.color + '"></div>'
      + '<span class="name" title="' + escapeHtml(dv.id) + '">' + escapeHtml(dv.id) + '</span>'
      + '<span class="count">' + dv.count + '</span></div>';
  }
  el.innerHTML = html;
  el.querySelectorAll('.device-item').forEach(item => {
    item.addEventListener('click', () => {
      state.selected = item.dataset.id;
      renderDevicePanel();
      renderChart();
      renderStatStrip();
      renderDetailTable();
    });
  });
}

function getVisibleDevices() {
  if (state.selected === 'all') return state.devices;
  return state.devices.filter(d => d.id === state.selected);
}

function renderChart() {
  const datasets = [];
  for (const dv of getVisibleDevices()) {
    const raw = state.byDevice[dv.id] || [];
    if (!raw.length) continue;
    const data = bucketize(raw, state.bucketSec);
    const points = data
      .filter(r => state.metric === 'temperature' ? r.temperature != null : r.humidity != null)
      .map(r => ({ x: r.ts, y: state.metric === 'temperature' ? r.temperature : r.humidity }));
    if (!points.length) continue;
    datasets.push({
      label: dv.id,
      data: points,
      borderColor: dv.color,
      backgroundColor: dv.color + '20',
      tension: 0.25,
      borderWidth: 2,
      pointRadius: state.selected === 'all' ? 2 : 3,
      pointHoverRadius: 5,
    });
  }
  if (window._chart) window._chart.destroy();
  const ctx = $('chart').getContext('2d');
  const isTemp = state.metric === 'temperature';
  window._chart = new Chart(ctx, {
    type: 'line',
    data: { datasets },
    options: {
      responsive: true, maintainAspectRatio: false,
      interaction: { mode: 'nearest', axis: 'x', intersect: false },
      plugins: {
        legend: { display: state.selected === 'all', position: 'top', align: 'end',
                  labels: { color: '#d4d8e0', font: { size: 11 }, boxWidth: 12 } },
        tooltip: {
          callbacks: {
            label: ctx => ctx.dataset.label + ': ' + ctx.parsed.y.toFixed(1) + (isTemp ? ' °C' : ' %'),
            title: items => fmtTime(items[0].parsed.x),
          },
        },
      },
      scales: {
        x: {
          type: 'time',
          time: { tooltipFormat: 'yyyy-MM-dd HH:mm:ss',
                  displayFormats: { minute: 'HH:mm', hour: 'MM-dd HH:mm', day: 'MM-dd' } },
          ticks: { color: '#6b7280' },
          grid: { color: '#2a2f3a' },
        },
        y: {
          position: 'left',
          title: { display: true, text: isTemp ? '°C 温度' : '% 湿度',
                   color: isTemp ? '#f97316' : '#38bdf8' },
          ticks: { color: isTemp ? '#f97316' : '#38bdf8' },
          grid: { color: '#2a2f3a' },
        },
      },
    },
  });
}

function renderStatStrip() {
  const all = [];
  for (const dv of getVisibleDevices()) {
    for (const r of (state.byDevice[dv.id] || [])) all.push(r);
  }
  const v = arr => arr.length ? (arr.reduce((a, b) => a + b, 0) / arr.length).toFixed(1) : '--';
  const mx = arr => arr.length ? Math.max(...arr).toFixed(1) : '--';
  const mn = arr => arr.length ? Math.min(...arr).toFixed(1) : '--';
  const temps = all.map(r => r.temperature).filter(x => x != null);
  const hums = all.map(r => r.humidity).filter(x => x != null);
  const isTemp = state.metric === 'temperature';
  const stat = isTemp
    ? [['平均', v(temps)], ['最高', mx(temps)], ['最低', mn(temps)], ['读数', all.length]]
    : [['平均', v(hums)], ['最高', mx(hums)], ['最低', mn(hums)], ['读数', all.length]];
  const unit = isTemp ? '°C' : '%';
  $('stat-strip').innerHTML = stat.map(([l, val]) =>
    '<div class="stat"><div class="label">' + l + '</div><div class="value">'
    + val + (typeof val === 'string' && val !== '--' ? '<span class="unit">' + unit + '</span>' : '')
    + '</div></div>'
  ).join('');
}

function renderDetailTable() {
  const tbody = $('detail-body');
  if (state.selected === 'all') {
    tbody.innerHTML = '<tr><td colspan="5" class="empty">选左侧具体设备查看</td></tr>';
    return;
  }
  const list = (state.byDevice[state.selected] || []).slice().reverse().slice(0, 30);
  if (!list.length) {
    tbody.innerHTML = '<tr><td colspan="5" class="empty">该设备无数据</td></tr>';
    return;
  }
  const dv = state.devices.find(d => d.id === state.selected);
  const color = dv ? dv.color : '#888';
  tbody.innerHTML = list.map(r =>
    '<tr><td class="dot-cell"><div class="device-item" style="padding:0;width:10px;height:10px;border:none;background:' + color + ';border-radius:50%"></div></td>'
    + '<td class="time">' + fmtTime(r.ts) + '</td>'
    + '<td class="num">' + (r.temperature != null ? r.temperature.toFixed(1) : '--') + '</td>'
    + '<td class="num">' + (r.humidity != null ? r.humidity.toFixed(1) : '--') + '</td>'
    + '<td>' + escapeHtml(r.source || 'device') + '</td></tr>'
  ).join('');
}

async function injectTestData() {
  // Simulate two ESP32 sensors on the LAN. We can't spoof the socket
  // source IP, but we can hit GET /api/esp/<device_id> with explicit
  // device_id in the path + sensor data as query params. (POST /api/readings
  // was removed — /api/esp/* is now the only upload channel.)
  const now = Date.now();
  const testDevs = ['192.168.8.80', '192.168.8.81'];
  const allReadings = [];
  for (const dev of testDevs) {
    const base = dev === '192.168.8.80' ? 24 : 22;
    for (let h = 24; h >= 0; h--) {
      const ts = new Date(now - h * 3600 * 1000).toISOString();
      const temp = base + Math.sin((24 - h) / 24 * Math.PI * 2) * 4 + (Math.random() - 0.5);
      const hum = 60 + Math.cos((24 - h) / 24 * Math.PI * 2) * 15 + (Math.random() - 0.5) * 5;
      allReadings.push({ device_id: dev, ts, temperature: +temp.toFixed(1), humidity: +hum.toFixed(1), source: 'sim' });
    }
  }
  // Backend only keeps the LAST reading per device (each /api/esp hit is
  // recorded with "now()" timestamp), so we send each device's most recent
  // sample once. The dashboard shows "live" data, not historical.
  // For demo data with a 24h spread, just hit it 24 times per device with
  // backdated server-side time — not supported via HTTP. So we send only
  // the latest reading per device; the user can click multiple times to
  // accumulate samples.
  for (const dev of testDevs) {
    const latest = allReadings[allReadings.length - (dev.endsWith('.80') ? 2 : 1)];
    const url = `/api/esp/${encodeURIComponent(dev)}?temperature=${latest.temperature}&humidity=${latest.humidity}`;
    await fetch(url);
  }
  await loadDevices();
  await loadReadings();
}

function escapeHtml(s) { return String(s).replace(/[&<>"']/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c])); }

$('refresh-btn').addEventListener('click', loadReadings);
$('test-btn').addEventListener('click', injectTestData);
$('window-select').addEventListener('change', e => { state.windowHours = +e.target.value; loadReadings(); });
$('bucket-select').addEventListener('change', e => { state.bucketSec = +e.target.value; renderChart(); renderStatStrip(); });
document.querySelectorAll('.tab').forEach(t => t.addEventListener('click', () => {
  document.querySelectorAll('.tab').forEach(x => x.classList.remove('active'));
  t.classList.add('active');
  state.metric = t.dataset.metric;
  renderChart(); renderStatStrip();
}));

// Auto refresh every 30s
setInterval(loadReadings, 30000);

(async () => { await loadDevices(); await loadReadings(); })();
</script>
</body>
</html>