<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>设置 · 安睡小方电台</title>
  <link rel="stylesheet" href="/css/site.css">
  <link rel="stylesheet" href="/css/site-mobile.css">
  <style>
    /* Settings 独有：field 三列 grid / results 列表 / badge / current 城市条 / row */
    .container { max-width: 760px; margin: 0 auto; }
    h1 { font-size: 18px; margin-bottom: 12px; color: var(--accent); }
    body { padding: 16px; font-size: 13px; line-height: 1.5; }

    .field {
      display: grid; grid-template-columns: 140px 1fr auto;
      gap: 8px; align-items: center; margin-bottom: 8px;
    }
    .field label { color: var(--text-dim); font-size: 12px; }
    .field .help { grid-column: 2 / 4; color: var(--text-dim); font-size: 11px; margin: -4px 0 8px; }

    .row { display: flex; gap: 8px; align-items: center; margin-bottom: 8px; }
    .row > input, .row > select { flex: 1; min-width: 0; }

    .results {
      max-height: 360px; overflow-y: auto;
      border: 1px solid var(--border); border-radius: 4px;
      background: var(--surface2);
    }
    .result {
      padding: 8px 12px; border-bottom: 1px solid var(--border);
      cursor: pointer; display: flex; justify-content: space-between;
      align-items: center; gap: 12px; transition: background 0.1s;
    }
    .result:last-child { border-bottom: none; }
    .result:hover { background: var(--surface); }
    .result .info { flex: 1; min-width: 0; }
    .result .name { font-size: 13px; }
    .result .adm { font-size: 11px; color: var(--text-dim); margin-top: 2px; }
    .result .id { font-size: 11px; color: var(--text-dim); font-family: monospace; }
    .empty, .err {
      padding: 16px; text-align: center; color: var(--text-dim); font-size: 12px;
    }
    .err { color: var(--err); }

    /* 当前城市条 */
    .current {
      display: flex; align-items: center; gap: 10px;
      padding: 8px 12px; background: var(--surface2);
      border: 1px solid var(--border); border-radius: 4px;
    }
    .current .pin { font-size: 18px; }
    .current .name { font-weight: 500; }
    .current .adm { color: var(--text-dim); font-size: 11px; }
    .current .id { color: var(--text-dim); font-size: 11px; font-family: monospace; margin-left: auto; }

    .section-actions { display: flex; gap: 8px; margin-top: 12px; flex-wrap: wrap; }

    /* Badge（API key 已设置/未设置的状态点） */
    .badge {
      display: inline-block; padding: 2px 6px; border-radius: 3px;
      font-size: 10px; background: var(--surface2); color: var(--text-dim);
    }
    .badge.ok   { background: rgba(34, 197, 94, 0.15); color: var(--accent); }
    .badge.warn { background: rgba(245, 158, 11, 0.15); color: var(--warn); }
  </style>
</head>
<body>
  <div class="container">
    <%- include("partials/_nav") %>
    <h1>⚙️ 设置</h1>

    <!-- ============== 天气 ============== -->
    <div class="card">
      <h2>📍 天气</h2>
      <div class="meta">和风天气（QWeather）。城市改了之后下一次播放或查询时生效（5 分钟缓存）。</div>

      <div class="field">
        <label>当前城市</label>
        <div class="current" id="weather-current" style="margin: 0;">
          <div class="pin">📌</div>
          <div class="info" style="flex: 1;">
            <div class="name" id="weather-name">加载中…</div>
            <div class="adm" id="weather-adm"></div>
          </div>
          <div class="id" id="weather-id"></div>
        </div>
        <button class="btn" id="weather-change-btn">更改</button>
      </div>

      <div id="weather-search" style="display: none;">
        <div class="row">
          <input class="input" id="search-q"
                 placeholder="输入城市或区/县名称（如 余杭、临平、上城）"
                 autocomplete="off" />
          <button class="btn" id="search-btn">🔍 搜索</button>
        </div>
        <div id="results" class="results" style="margin-top: 8px;">
          <div class="empty">输入关键词后点击搜索</div>
        </div>
      </div>

      <h2 style="margin-top: 18px;">🔑 API 配置</h2>
      <div class="meta">和风天气的 API key 和 host。私密字段不回显全值。</div>

      <div class="field">
        <label for="weather-key">API Key</label>
        <input class="input mono" id="weather-key" type="password"
               placeholder="未设置（使用默认）" />
        <button class="btn" id="weather-key-toggle">👁</button>
        <div class="help">
          <span id="weather-key-status" class="badge warn">未设置</span>
          留空 = 使用默认 key。修改后立即对下一次天气查询生效。
        </div>
      </div>

      <div class="field">
        <label for="weather-host">API Host</label>
        <input class="input mono" id="weather-host"
               placeholder="api.qweather.com" />
        <div class="help">和风天气的反代域名。留空使用默认。</div>
      </div>

      <div class="section-actions">
        <button class="btn btn-primary" id="weather-save">💾 保存</button>
        <button class="btn btn-danger" id="weather-key-clear">🗑️ 清除 API Key</button>
      </div>
    </div>

    <!-- ============== LLM + TTS ============== -->
    <div class="card">
      <h2>🤖 模型与语音</h2>
      <div class="meta">
        LLM 可选 MiniMax 或 DeepSeek；TTS 使用 MiniMax，可独立关闭。私密字段不回显全值。
      </div>

      <div class="field">
        <label for="llm-provider">LLM 提供商</label>
        <select class="input" id="llm-provider">
          <option value="minimax">MiniMax</option>
          <option value="deepseek">DeepSeek</option>
        </select>
        <div class="help">选歌、关键词和播报文案使用的模型服务。</div>
      </div>

      <div class="field deepseek-field">
        <label for="deepseek-key">DeepSeek API Key</label>
        <input class="input mono" id="deepseek-key" type="password" placeholder="未设置" />
        <button class="btn" id="deepseek-key-toggle">👁</button>
        <div class="help"><span id="deepseek-key-status" class="badge warn">未设置</span></div>
      </div>

      <div class="field deepseek-field">
        <label for="deepseek-base">DeepSeek Base URL</label>
        <input class="input mono" id="deepseek-base"
               placeholder="https://api.deepseek.com/chat/completions" />
        <div class="help">DeepSeek 的 OpenAI 兼容接口。</div>
      </div>

      <div class="field deepseek-field">
        <label for="deepseek-model">DeepSeek Model</label>
        <select class="input mono" id="deepseek-model">
          <option value="deepseek-v4-flash">deepseek-v4-flash</option>
          <option value="deepseek-v4-pro">deepseek-v4-pro</option>
        </select>
        <div class="help">日常生成建议使用速度更快、成本更低的 deepseek-v4-flash。</div>
      </div>

      <div class="field mmx-required-field">
        <label for="mmx-key">MiniMax API Token</label>
        <input class="input mono" id="mmx-key" type="password"
               placeholder="未设置" />
        <button class="btn" id="mmx-key-toggle">👁</button>
        <div class="help">
          <span id="mmx-key-status" class="badge warn">未设置</span>
          MiniMax LLM 或 TTS 开启时需要。区域：<code>minimaxi.com</code>（CN 区域 key，<code>sk-cp-</code> 开头）。
        </div>
      </div>

      <div class="field minimax-llm-field">
        <label for="mmx-anthropic-base">Anthropic Base URL</label>
        <input class="input mono" id="mmx-anthropic-base"
               placeholder="https://api.minimaxi.com/anthropic/v1/messages" />
        <div class="help">LLM 调用的 endpoint。</div>
      </div>

      <div class="field minimax-llm-field">
        <label for="mmx-anthropic-model">Anthropic Model</label>
        <input class="input mono" id="mmx-anthropic-model"
               placeholder="MiniMax-M3" />
        <div class="help">LLM 模型名。</div>
      </div>

      <div class="field">
        <label for="tts-enabled">TTS 讲解语音</label>
        <input id="tts-enabled" type="checkbox" />
        <div class="help">关闭后不要求填写 TTS 配置，也不会生成播报文案、语音或拼接音频。</div>
      </div>

      <div class="field tts-field">
        <label for="mmx-tts-base">TTS Base URL</label>
        <input class="input mono" id="mmx-tts-base"
               placeholder="https://api.minimaxi.com/v1/t2a_v2" />
        <div class="help">TTS HTTP endpoint。</div>
      </div>

      <div class="field tts-field">
        <label for="mmx-tts-model">TTS Model</label>
        <input class="input mono" id="mmx-tts-model"
               placeholder="speech-02-turbo" />
        <div class="help">TTS 模型。</div>
      </div>

      <div class="field tts-field">
        <label for="mmx-tts-voice">TTS Voice</label>
        <input class="input mono" id="mmx-tts-voice"
               placeholder="male-qn-qingse" />
        <div class="help">语音 ID（如 <code>male-qn-qingse</code>, <code>Chinese (Mandarin)_Male_Announcer</code>）。</div>
      </div>

      <div class="section-actions">
        <button class="btn btn-primary" id="mmx-save">💾 保存模型与语音</button>
        <button class="btn btn-danger" id="mmx-key-clear">🗑️ 清除 Token</button>
      </div>
    </div>

    <!-- ============== 曲库 ============== -->
    <div class="card">
      <h2>📀 曲库</h2>
      <div class="meta">本地曲库目录路径。单电台模式：所有 mp3 放在同一目录下。</div>

      <div class="field">
        <label for="stations-dir">stationsDir</label>
        <input class="input mono" id="stations-dir"
               placeholder="~/Music/网易云收藏" />
        <button class="btn" id="stations-dir-pick">📂 探测</button>
        <div class="help">点击「探测」检查目录是否存在 + 列出 mp3 数量。</div>
      </div>

      <div class="section-actions">
        <button class="btn btn-primary" id="library-save">💾 保存</button>
      </div>
    </div>

    <!-- ============== 闹钟 ============== -->
    <div class="card">
      <h2>⏰ 闹钟</h2>
      <div class="meta">每天的起床闹铃。ESP32 端点 <code>/api/esp</code> 会带上这个字段。</div>

      <div class="field">
        <label class="row">
          <input type="checkbox" id="alarm-enabled" />
          <span>开启闹铃（总开关）</span>
        </label>
        <div class="help">关闭后所有闹铃行为都不会触发。默认开启。</div>
      </div>

      <div class="field">
        <label for="alarm-time">闹铃时间 (HH:MM)</label>
        <input class="input mono" id="alarm-time" type="time" />
        <div class="help">24 小时制。仅在「开启闹铃」勾选时生效。</div>
      </div>

      <div class="field">
        <label>周末设置</label>
        <label class="row">
          <input type="checkbox" id="alarm-saturday" />
          <span>周六也响</span>
        </label>
        <label class="row">
          <input type="checkbox" id="alarm-sunday" />
          <span>周日也响</span>
        </label>
        <div class="help">默认关闭 — 周末不响。周一至周五只要总开关打开就一定响。</div>
      </div>

      <div class="section-actions">
        <button class="btn btn-primary" id="alarm-save">💾 保存</button>
      </div>
    </div>

    <div id="toast" class="toast"></div>
  </div>

  <script>
    const $ = id => document.getElementById(id);
    const toast = (msg, isErr = false) => {
      const t = $('toast');
      t.textContent = msg;
      t.className = 'toast show' + (isErr ? ' err' : '');
      clearTimeout(t._t);
      t._t = setTimeout(() => t.className = 'toast' + (isErr ? ' err' : ''), 2200);
    };

    // Toggle password visibility
    function wireToggle(inputId, btnId) {
      const inp = $(inputId), btn = $(btnId);
      btn.addEventListener('click', () => {
        inp.type = inp.type === 'password' ? 'text' : 'password';
      });
    }
    wireToggle('weather-key', 'weather-key-toggle');
    wireToggle('mmx-key', 'mmx-key-toggle');
    wireToggle('deepseek-key', 'deepseek-key-toggle');

    function renderModelFields() {
      const provider = $('llm-provider').value;
      document.querySelectorAll('.deepseek-field').forEach(el => {
        el.style.display = provider === 'deepseek' ? '' : 'none';
      });
      document.querySelectorAll('.minimax-llm-field').forEach(el => {
        el.style.display = provider === 'minimax' ? '' : 'none';
      });
      const ttsEnabled = $('tts-enabled').checked;
      document.querySelectorAll('.mmx-required-field').forEach(el => {
        el.style.display = provider === 'minimax' || ttsEnabled ? '' : 'none';
      });
      document.querySelectorAll('.tts-field').forEach(el => {
        el.style.display = ttsEnabled ? '' : 'none';
      });
    }
    $('llm-provider').addEventListener('change', renderModelFields);
    $('tts-enabled').addEventListener('change', renderModelFields);

    // ----- Load current settings -----
    let _settings = null;
    async function loadAll() {
      const r = await fetch('/api/settings');
      _settings = await r.json();
      renderAll();
      await loadWeatherCity();
    }
    function renderAll() {
      // Weather
      $('weather-host').value = _settings.weather.host;
      setKeyStatus('weather-key-status', _settings.weather.apiKey, 'weather-key');
      // minimax
      $('llm-provider').value = _settings.minimax.llmProvider || 'minimax';
      $('deepseek-base').value = _settings.minimax.deepseekBase || '';
      $('deepseek-model').value = _settings.minimax.deepseekModel || 'deepseek-v4-flash';
      $('mmx-anthropic-base').value = _settings.minimax.anthropicBase;
      $('mmx-anthropic-model').value = _settings.minimax.anthropicModel;
      $('tts-enabled').checked = _settings.minimax.ttsEnabled !== false;
      $('mmx-tts-base').value = _settings.minimax.ttsBase;
      $('mmx-tts-model').value = _settings.minimax.ttsModel;
      $('mmx-tts-voice').value = _settings.minimax.ttsVoiceId;
      setKeyStatus('mmx-key-status', _settings.minimax.apiKey, 'mmx-key');
      setKeyStatus('deepseek-key-status', _settings.minimax.deepseekApiKey, 'deepseek-key');
      renderModelFields();
      // Library
      $('stations-dir').value = _settings.library.stationsDir;
      // Alarm
      const a = _settings.alarm || {};
      $('alarm-enabled').checked  = a.enabled !== false;
      $('alarm-time').value       = a.time || '';
      $('alarm-saturday').checked = a.weekend_saturday === true;
      $('alarm-sunday').checked   = a.weekend_sunday === true;
    }
    function setKeyStatus(badgeId, k, inputId) {
      const b = $(badgeId);
      if (k.set) {
        b.textContent = '已设置 (' + k.preview + ')';
        b.className = 'badge ok';
        $(inputId).placeholder = '已设置 (' + k.preview + ') — 输入新值替换';
      } else {
        b.textContent = '未设置';
        b.className = 'badge warn';
        $(inputId).placeholder = '未设置';
      }
    }

    // ----- Weather city -----
    async function loadWeatherCity() {
      try {
        const r = await fetch('/api/weather/location');
        const c = await r.json();
        $('weather-name').textContent = c.locationName || '—';
        const adm = [c.adm1, c.adm2].filter(Boolean).join(' / ');
        $('weather-adm').textContent = adm;
        $('weather-id').textContent = c.locationId || '';
      } catch (e) {
        $('weather-name').textContent = '加载失败';
      }
    }

    // ----- Save handlers -----
    async function saveWeather() {
      const body = { weather: {} };
      const h = $('weather-host').value.trim();
      if (h) body.weather.host = h;
      // apiKey: if field is non-empty and not the placeholder, send it.
      // Empty value = clear.
      const k = $('weather-key').value;
      if (k === '') {
        // explicit clear
        if (confirm('确定要清除和风天气 API Key 吗？清除后将使用默认 key。')) {
          body.weather.apiKey = '';
        } else {
          return;
        }
      } else if (k) {
        body.weather.apiKey = k;
      }
      await doSave('weather', body);
    }

    async function saveMmx() {
      const body = { minimax: {
        llmProvider: $('llm-provider').value,
        ttsEnabled: $('tts-enabled').checked,
      } };
      const k = $('mmx-key').value;
      if (k === '') {
        if (_settings.minimax.apiKey.set && confirm('确定要清除 MiniMax Token 吗？')) {
          body.minimax.apiKey = '';
        }
      } else if (k) {
        body.minimax.apiKey = k;
      }
      const deepseekKey = $('deepseek-key').value;
      if (deepseekKey === '') {
        if (_settings.minimax.deepseekApiKey.set && confirm('确定要清除 DeepSeek API Key 吗？')) {
          body.minimax.deepseekApiKey = '';
        }
      } else {
        body.minimax.deepseekApiKey = deepseekKey;
      }
      const m = (id) => $(id).value.trim();
      const v_deepseekBase = m('deepseek-base');
      const v_deepseekModel = m('deepseek-model');
      const v_anthropicBase = m('mmx-anthropic-base');
      const v_anthropicModel = m('mmx-anthropic-model');
      const v_ttsBase = m('mmx-tts-base');
      const v_ttsModel = m('mmx-tts-model');
      const v_ttsVoice = m('mmx-tts-voice');
      if (v_deepseekBase) body.minimax.deepseekBase = v_deepseekBase;
      if (v_deepseekModel) body.minimax.deepseekModel = v_deepseekModel;
      if (v_anthropicBase) body.minimax.anthropicBase = v_anthropicBase;
      if (v_anthropicModel) body.minimax.anthropicModel = v_anthropicModel;
      if (v_ttsBase) body.minimax.ttsBase = v_ttsBase;
      if (v_ttsModel) body.minimax.ttsModel = v_ttsModel;
      if (v_ttsVoice) body.minimax.ttsVoiceId = v_ttsVoice;
      await doSave('minimax', body);
    }

    async function saveLibrary() {
      const d = $('stations-dir').value.trim();
      if (!d) { toast('路径不能为空', true); return; }
      await doSave('library', { library: { stationsDir: d } });
    }

    async function saveAlarm() {
      const t = $('alarm-time').value.trim();
      if (t && !/^([01]\d|2[0-3]):[0-5]\d$/.test(t)) {
        toast('时间格式错误，应为 HH:MM', true);
        return;
      }
      const body = {
        alarm: {
          enabled:          $('alarm-enabled').checked,
          time:             t,
          weekend_saturday: $('alarm-saturday').checked,
          weekend_sunday:   $('alarm-sunday').checked,
        },
      };
      await doSave('alarm', body);
    }

    async function doSave(label, body) {
      try {
        const r = await fetch('/api/settings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        const j = await r.json();
        if (!r.ok) { toast('保存失败: ' + (j.error || r.status), true); return; }
        _settings = j.settings;
        renderAll();
        toast(label + ' 已保存');
        // Clear input fields after save
        $('weather-key').value = '';
        $('mmx-key').value = '';
        $('deepseek-key').value = '';
      } catch (e) { toast('保存失败: ' + e.message, true); }
    }

    // ----- Weather city search (existing) -----
    $('weather-change-btn').addEventListener('click', () => {
      const s = $('weather-search');
      s.style.display = s.style.display === 'none' ? 'block' : 'none';
    });
    let lookupAbort = null;
    async function doSearch() {
      const q = $('search-q').value.trim();
      if (!q) { toast('请输入城市名', true); return; }
      if (lookupAbort) lookupAbort.abort();
      lookupAbort = new AbortController();
      $('results').innerHTML = '<div class="empty">搜索中…</div>';
      try {
        const r = await fetch(`/api/weather/lookup?q=${encodeURIComponent(q)}`, {
          signal: lookupAbort.signal,
        });
        const j = await r.json();
        if (!r.ok) {
          $('results').innerHTML = `<div class="err">${j.error || '查询失败'}</div>`;
          return;
        }
        const list = j.locations || [];
        if (list.length === 0) {
          $('results').innerHTML = '<div class="empty">没有匹配的城市</div>';
          return;
        }
        $('results').innerHTML = list.map(loc => `
          <div class="result" data-id="${loc.id}" data-name="${loc.name}"
               data-adm1="${loc.adm1 || ''}" data-adm2="${loc.adm2 || ''}">
            <div class="info">
              <div class="name">${loc.name}</div>
              <div class="adm">${[loc.adm1, loc.adm2].filter(Boolean).join(' / ')}${loc.country ? ' / ' + loc.country : ''}</div>
            </div>
            <div class="id">${loc.id}</div>
          </div>
        `).join('');
        $('results').querySelectorAll('.result').forEach(el => {
          el.addEventListener('click', () => selectLocation({
            locationId: el.dataset.id,
            locationName: el.dataset.name,
            adm1: el.dataset.adm1,
            adm2: el.dataset.adm2,
          }));
        });
      } catch (e) {
        if (e.name !== 'AbortError') {
          $('results').innerHTML = `<div class="err">${e.message}</div>`;
        }
      }
    }
    async function selectLocation(loc) {
      if (!confirm(`确定把城市切换到「${loc.adm1} / ${loc.adm2} / ${loc.locationName}」吗？`)) return;
      try {
        const r = await fetch('/api/weather/location', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(loc),
        });
        const j = await r.json();
        if (!r.ok) { toast('保存失败: ' + (j.error || r.status), true); return; }
        toast(`已切换到 ${loc.locationName}`);
        await loadWeatherCity();
        $('results').innerHTML = '<div class="empty">已保存</div>';
      } catch (e) { toast('保存失败: ' + e.message, true); }
    }
    $('search-btn').addEventListener('click', doSearch);
    $('search-q').addEventListener('keydown', e => { if (e.key === 'Enter') doSearch(); });
    let debounce = null;
    $('search-q').addEventListener('input', () => {
      clearTimeout(debounce);
      debounce = setTimeout(() => {
        const q = $('search-q').value.trim();
        if (q.length >= 2) doSearch();
      }, 400);
    });

    // ----- Save button bindings -----
    $('weather-save').addEventListener('click', saveWeather);
    $('mmx-save').addEventListener('click', saveMmx);
    $('library-save').addEventListener('click', saveLibrary);
    $('alarm-save').addEventListener('click', saveAlarm);
    $('weather-key-clear').addEventListener('click', () => {
      if (!confirm('清除和风天气 API Key？')) return;
      $('weather-key').value = '';
      saveWeather();
    });
    $('mmx-key-clear').addEventListener('click', () => {
      if (!confirm('清除 minimax Token？')) return;
      $('mmx-key').value = '';
      saveMmx();
    });

    // ----- Stations dir probe -----
    $('stations-dir-pick').addEventListener('click', async () => {
      // We don't have a "probe" endpoint, but /api/library works to verify
      // the dir is reachable. Open it.
      const r = await fetch('/api/library?days=0').catch(() => null);
      if (r && r.ok) {
        const j = await r.json();
        toast('目录可访问，歌曲数: ' + (j.total || 0));
      } else {
        toast('无法访问目录', true);
      }
    });

    loadAll();
  </script>
</body>
</html>
