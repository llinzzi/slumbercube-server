<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>设置 · 192电台</title>
  <style>
    :root {
      --bg: #0d0f14; --surface: #15181f; --surface2: #1c2029;
      --border: #2a2f3a; --text: #d4d8e0; --text-dim: #6b7280;
      --accent: #22c55e; --err: #ef4444; --warn: #f59e0b;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
      background: var(--bg); color: var(--text); font-size: 13px;
      padding: 16px; line-height: 1.5;
    }
    .container { max-width: 720px; margin: 0 auto; }
    h1 { font-size: 18px; margin-bottom: 12px; color: var(--accent); }
    .card {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 6px; padding: 16px; margin-bottom: 16px;
    }
    .card h2 {
      font-size: 14px; margin-bottom: 8px; color: var(--text);
      display: flex; align-items: center; gap: 6px;
    }
    .meta { color: var(--text-dim); font-size: 12px; }
    .row { display: flex; gap: 8px; align-items: center; margin-bottom: 8px; }
    .row > * { flex-shrink: 0; }
    .row > input, .row > select { flex: 1; min-width: 0; }
    .input {
      background: var(--surface2); color: var(--text);
      border: 1px solid var(--border); border-radius: 4px;
      padding: 6px 10px; font-size: 13px; font-family: inherit;
    }
    .input:focus { outline: none; border-color: var(--accent); }
    .btn {
      background: var(--surface2); color: var(--text);
      border: 1px solid var(--border); border-radius: 4px;
      padding: 6px 14px; cursor: pointer; font-size: 12px;
      font-family: inherit; transition: all 0.1s;
    }
    .btn:hover { border-color: var(--accent); color: var(--accent); }
    .btn-primary {
      background: var(--accent); color: #0d0f14; border-color: var(--accent);
      font-weight: 500;
    }
    .btn-primary:hover { color: #0d0f14; opacity: 0.85; }
    .results {
      max-height: 360px; overflow-y: auto;
      border: 1px solid var(--border); border-radius: 4px;
      background: var(--surface2);
    }
    .result {
      padding: 8px 12px; border-bottom: 1px solid var(--border);
      cursor: pointer; display: flex; justify-content: space-between;
      align-items: center; gap: 12px; transition: background 0.1s;
    }
    .result:last-child { border-bottom: none; }
    .result:hover { background: var(--surface); }
    .result .info { flex: 1; min-width: 0; }
    .result .name { font-size: 13px; }
    .result .adm { font-size: 11px; color: var(--text-dim); margin-top: 2px; }
    .result .id { font-size: 11px; color: var(--text-dim); font-family: monospace; }
    .empty, .err {
      padding: 16px; text-align: center; color: var(--text-dim); font-size: 12px;
    }
    .err { color: var(--err); }
    .current {
      background: var(--surface2); border: 1px solid var(--border);
      border-radius: 4px; padding: 12px; display: flex;
      align-items: center; gap: 12px; margin-bottom: 12px;
    }
    .current .pin { color: var(--accent); font-size: 16px; }
    .current .name { font-size: 14px; font-weight: 500; }
    .current .adm { font-size: 11px; color: var(--text-dim); margin-top: 2px; }
    .current .id { font-family: monospace; color: var(--text-dim); font-size: 11px; }
    .toast {
      position: fixed; bottom: 16px; left: 50%; transform: translateX(-50%);
      background: var(--surface); border: 1px solid var(--border);
      color: var(--text); padding: 8px 16px; border-radius: 4px;
      font-size: 12px; opacity: 0; transition: opacity 0.2s;
      pointer-events: none; z-index: 100;
    }
    .toast.show { opacity: 1; }
    .toast.err { border-color: var(--err); color: var(--err); }
  </style>
</head>
<body>
  <div class="container">
    <%- include("partials/_nav") %>
    <h1>⚙️ 设置</h1>

    <div class="card">
      <h2>📍 天气城市</h2>
      <div class="meta" style="margin-bottom: 12px;">
        用于查询实时天气和未来 7 天预报。和风天气（QWeather）支持精确到区/县。
      </div>

      <div class="current" id="current">
        <div class="pin">📌</div>
        <div class="info" style="flex: 1;">
          <div class="name" id="current-name">加载中…</div>
          <div class="adm" id="current-adm"></div>
        </div>
        <div class="id" id="current-id"></div>
      </div>

      <div class="row">
        <input
          class="input"
          id="search-q"
          placeholder="输入城市或区/县名称（如 余杭、临平、上城）"
          autocomplete="off"
        />
        <button class="btn" id="search-btn">🔍 搜索</button>
      </div>

      <div id="results" class="results" style="margin-top: 8px;">
        <div class="empty">输入关键词后点击搜索</div>
      </div>

      <div class="meta" style="margin-top: 8px;">
        💡 提示：天气缓存 5 分钟，保存后下一次自动播放或查询时生效。
      </div>
    </div>

    <div id="toast" class="toast"></div>
  </div>

  <script>
    const $ = id => document.getElementById(id);
    const toast = (msg, isErr = false) => {
      const t = $('toast');
      t.textContent = msg;
      t.className = 'toast show' + (isErr ? ' err' : '');
      clearTimeout(t._t);
      t._t = setTimeout(() => t.className = 'toast' + (isErr ? ' err' : ''), 2200);
    };

    async function loadCurrent() {
      try {
        const r = await fetch('/api/weather/location');
        const c = await r.json();
        $('current-name').textContent = c.locationName || '—';
        const adm = [c.adm1, c.adm2].filter(Boolean).join(' / ');
        $('current-adm').textContent = adm;
        $('current-id').textContent = c.locationId || '';
      } catch (e) {
        $('current-name').textContent = '加载失败';
        toast('加载当前城市失败: ' + e.message, true);
      }
    }

    let lookupAbort = null;
    async function doSearch() {
      const q = $('search-q').value.trim();
      if (!q) { toast('请输入城市名', true); return; }
      if (lookupAbort) lookupAbort.abort();
      lookupAbort = new AbortController();

      $('results').innerHTML = '<div class="empty">搜索中…</div>';
      try {
        const r = await fetch(`/api/weather/lookup?q=${encodeURIComponent(q)}`, {
          signal: lookupAbort.signal,
        });
        const j = await r.json();
        if (!r.ok) {
          $('results').innerHTML = `<div class="err">${j.error || '查询失败'}</div>`;
          return;
        }
        const list = j.locations || [];
        if (list.length === 0) {
          $('results').innerHTML = '<div class="empty">没有匹配的城市</div>';
          return;
        }
        $('results').innerHTML = list.map(loc => `
          <div class="result" data-id="${loc.id}" data-name="${loc.name}"
               data-adm1="${loc.adm1 || ''}" data-adm2="${loc.adm2 || ''}">
            <div class="info">
              <div class="name">${loc.name}</div>
              <div class="adm">${[loc.adm1, loc.adm2].filter(Boolean).join(' / ')}${loc.country ? ' / ' + loc.country : ''}</div>
            </div>
            <div class="id">${loc.id}</div>
          </div>
        `).join('');
        // Wire click handlers
        $('results').querySelectorAll('.result').forEach(el => {
          el.addEventListener('click', () => selectLocation({
            locationId: el.dataset.id,
            locationName: el.dataset.name,
            adm1: el.dataset.adm1,
            adm2: el.dataset.adm2,
          }));
        });
      } catch (e) {
        if (e.name !== 'AbortError') {
          $('results').innerHTML = `<div class="err">${e.message}</div>`;
        }
      }
    }

    async function selectLocation(loc) {
      if (!confirm(`确定把城市切换到「${loc.adm1} / ${loc.adm2} / ${loc.locationName}」吗？`)) return;
      try {
        const r = await fetch('/api/weather/location', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(loc),
        });
        const j = await r.json();
        if (!r.ok) { toast('保存失败: ' + (j.error || r.status), true); return; }
        toast(`已切换到 ${loc.locationName}`);
        await loadCurrent();
        $('results').innerHTML = '<div class="empty">已保存</div>';
      } catch (e) {
        toast('保存失败: ' + e.message, true);
      }
    }

    // Wire up search
    $('search-btn').addEventListener('click', doSearch);
    $('search-q').addEventListener('keydown', e => { if (e.key === 'Enter') doSearch(); });
    // Debounced auto-search as user types
    let debounce = null;
    $('search-q').addEventListener('input', () => {
      clearTimeout(debounce);
      debounce = setTimeout(() => {
        const q = $('search-q').value.trim();
        if (q.length >= 2) doSearch();
      }, 400);
    });

    loadCurrent();
  </script>
</body>
</html>