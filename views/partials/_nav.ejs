<!--
  Shared top navigation. Include via EJS partial system: see
  the README section "Shared nav" for usage. Active state is
  auto-detected from window.location.pathname on the client, so no
  server-side state is required.
  Styles live in /css/site.css (and mobile overrides in site-mobile.css).
-->
<nav class="top-nav">
  <a href="/" class="nav-home">🎧 电台</a>
  <a href="/dj" class="nav-link" data-nav="dj">🎛 DJ Agent</a>
  <a href="/library"   class="nav-link" data-nav="library">📀 曲目库</a>
  <a href="/temps"     class="nav-link" data-nav="temps">🌡 温湿度</a>
  <a href="/log"       class="nav-link" data-nav="log">📋 日志</a>
  <a href="/settings" class="nav-link" data-nav="settings">⚙️ 设置</a>
</nav>
<script>
  // Mark the current page's nav link as active. The first path segment
  // (e.g. /dj → "dj", /temps → "temps", / → "") determines the
  // active state. Falls back to "" for home (no other link active).
  (function() {
    var seg = window.location.pathname.split('/').filter(Boolean)[0] || '';
    var link = document.querySelector('.top-nav .nav-link[data-nav="' + seg + '"]');
    if (link) link.classList.add('active');
  })();
</script>
