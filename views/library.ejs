<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>网易云收藏 · 安睡小方电台</title>
  <link rel="stylesheet" href="/css/site.css">
  <link rel="stylesheet" href="/css/site-mobile.css">
  <style>
    /* Library 独有：search、group、songs、play-btn、preview */

    .container { max-width: 960px; margin: 0 auto; }
    h1 { font-size: 22px; margin-bottom: 16px; }
    h1 span { color: var(--accent); }

    .header {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      margin-bottom: 14px;
      flex-wrap: wrap;
      gap: 10px;
    }
    .header .sub {
      color: var(--text-dim);
      font-size: 12px;
      font-family: 'SF Mono', monospace;
    }
    .refresh-btn {
      background: transparent;
      color: var(--text-dim);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 4px 10px;
      font-size: 12px;
      cursor: pointer;
      font-family: inherit;
      margin-left: 8px;
    }
    .refresh-btn:hover { color: var(--text); border-color: var(--text-dim); }

    .storage-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 10px;
      margin-bottom: 14px;
    }
    .storage-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 12px 14px;
    }
    .storage-card .label { color: var(--text-dim); font-size: 11px; margin-bottom: 4px; }
    .storage-card .value { color: var(--text); font-size: 18px; font-weight: 600; }
    .storage-card .detail { color: var(--text-dim); font-size: 10px; margin-top: 3px; }
    .storage-actions {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
      margin: -2px 0 14px;
    }
    .danger-btn {
      background: transparent;
      color: #f87171;
      border: 1px solid rgba(248,113,113,0.45);
      border-radius: 4px;
      padding: 5px 10px;
      font-size: 11px;
      cursor: pointer;
      font-family: inherit;
    }
    .danger-btn:hover { background: rgba(248,113,113,0.08); }
    .danger-btn:disabled { opacity: 0.45; cursor: wait; }
    .storage-status { color: var(--text-dim); font-size: 11px; }

    .search { margin-bottom: 14px; }
    .search input {
      width: 100%;
      background: var(--surface);
      border: 1px solid var(--border);
      color: var(--text);
      padding: 8px 12px;
      border-radius: 6px;
      font-size: 13px;
      font-family: inherit;
      outline: none;
    }
    .search input:focus { border-color: var(--accent); }
    .search input::placeholder { color: var(--text-dim); }

    /* Playlist group: parent header + child song table */
    .group {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      margin-bottom: 14px;
      overflow: hidden;
    }
    .group-head {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
      background: var(--surface2);
      border-bottom: 1px solid var(--border);
      cursor: pointer;
      user-select: none;
    }
    .group.collapsed .group-head { border-bottom: none; }
    .group-head:hover { background: rgba(255,255,255,0.035); }
    .group-head .toggle {
      color: var(--text-dim);
      width: 14px;
      font-size: 11px;
      transition: transform 0.15s ease;
    }
    .group:not(.collapsed) .group-head .toggle { transform: rotate(90deg); }
    .group.collapsed .songs { display: none; }
    .group-head .name {
      flex: 1;
      font-weight: 600;
      font-size: 14px;
      color: var(--text);
    }
    .group-head .name.untagged { color: var(--text-dim); font-style: italic; }
    .group-head .count {
      color: var(--text-dim);
      font-size: 12px;
      font-family: 'SF Mono', monospace;
    }
    .group-head .meta {
      color: var(--text-dim);
      font-size: 11px;
      font-family: 'SF Mono', monospace;
    }

    .songs {
      width: 100%;
      border-collapse: collapse;
    }
    .songs thead th {
      position: sticky;
      top: 0;
      text-align: left;
      padding: 8px 16px;
      font-size: 11px;
      font-weight: 600;
      color: var(--text-dim);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      z-index: 1;
    }
    .songs tbody tr { border-bottom: 1px solid var(--border); }
    .songs tbody tr:last-child { border-bottom: none; }
    .songs tbody tr:hover { background: rgba(255,255,255,0.02); }
    .songs tbody tr.selected { background: rgba(34,197,94,0.08); }
    .songs td { padding: 7px 16px; font-size: 12px; }
    .songs td.num { font-family: 'SF Mono', monospace; color: var(--text-dim); width: 50px; }
    .songs td.title { font-weight: 500; }
    .songs td.artist { color: var(--text-dim); }
    .songs td.audio-info { font-family: 'SF Mono', monospace; color: var(--text-dim); min-width: 190px; font-size: 11px; }
    .audio-info .primary { color: var(--text); }
    .audio-info .secondary { margin-top: 2px; }
    .songs td.time { font-family: 'SF Mono', monospace; color: var(--text-dim); width: 160px; font-size: 11px; }
    .songs td.act { width: 70px; text-align: right; }

    .play-btn {
      background: transparent;
      color: var(--accent);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 3px 9px;
      font-size: 11px;
      cursor: pointer;
      font-family: inherit;
      transition: all 0.15s;
    }
    .play-btn:hover { border-color: var(--accent); background: rgba(34,197,94,0.08); }
    .select-btn {
      background: transparent;
      color: var(--text-dim);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 3px 9px;
      font-size: 11px;
      cursor: pointer;
      font-family: inherit;
      white-space: nowrap;
      margin-left: 5px;
    }
    .select-btn:hover, .select-btn.selected { color: var(--accent); border-color: var(--accent); }
    .select-btn:disabled { opacity: 0.6; cursor: wait; }

    .state {
      padding: 28px 20px;
      text-align: center;
      color: var(--text-dim);
    }
    .state.error { color: #f87171; }

    .preview {
      position: fixed;
      left: 50%;
      transform: translateX(-50%);
      bottom: 20px;
      width: min(960px, calc(100vw - 40px));
      background: var(--surface2);
      border: 1px solid var(--accent);
      border-radius: 8px;
      padding: 10px 16px;
      display: none;
      align-items: center;
      gap: 14px;
      box-shadow: 0 8px 24px rgba(0,0,0,0.4);
      z-index: 10;
    }
    .preview.show { display: flex; }
    .preview .now { flex: 1; min-width: 0; }
    .preview .now .t { font-weight: 500; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .preview .now .a { font-size: 11px; color: var(--text-dim); }
    .preview audio { height: 32px; max-width: 360px; }
    .preview .close {
      background: transparent;
      color: var(--text-dim);
      border: none;
      cursor: pointer;
      font-size: 20px;
      padding: 0 6px;
      line-height: 1;
    }
    .preview .close:hover { color: var(--text); }
    @media (max-width: 720px) {
      .storage-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
  </style>
</head>
<body>
  <div class="container">
  
    <%- include("partials/_nav") %>
    <div class="header">
      <h1>📀 网易云收藏 <span>· DJ Agent 下载</span></h1>
      <div>
        <span class="sub" id="meta">加载中…</span>
        <button class="refresh-btn" id="refresh">刷新</button>
      </div>
    </div>

    <div class="storage-grid">
      <div class="storage-card">
        <div class="label">原始 MP3</div>
        <div class="value" id="original-size">—</div>
        <div class="detail" id="original-count">—</div>
      </div>
      <div class="storage-card">
        <div class="label">TTS 语音</div>
        <div class="value" id="tts-size">—</div>
        <div class="detail" id="tts-count">—</div>
      </div>
      <div class="storage-card">
        <div class="label">拼接 MP3</div>
        <div class="value" id="stitched-size">—</div>
        <div class="detail" id="stitched-count">—</div>
      </div>
      <div class="storage-card">
        <div class="label">磁盘剩余 / 总量</div>
        <div class="value" id="disk-free">—</div>
        <div class="detail" id="disk-total">—</div>
      </div>
    </div>
    <div class="storage-actions">
      <button class="danger-btn" id="clear-tts">清空 TTS MP3</button>
      <button class="danger-btn" id="clear-stitched">清空拼接 MP3</button>
      <span class="storage-status" id="storage-status">只清理生成文件，不会删除原始曲库。</span>
    </div>

    <div class="search">
      <input id="search" type="text" placeholder="按歌名/艺人/歌单名筛选…">
    </div>

    <div id="content">
      <div class="state">加载中…</div>
    </div>

    <div class="preview" id="preview">
      <div class="now">
        <div class="t" id="p-title">—</div>
        <div class="a" id="p-artist">—</div>
      </div>
      <audio id="audio" controls></audio>
      <button class="close" id="p-close" title="关闭">×</button>
    </div>
  </div>

  <script>
    const contentEl = document.getElementById('content');
    const meta = document.getElementById('meta');
    const refresh = document.getElementById('refresh');
    const search = document.getElementById('search');
    const preview = document.getElementById('preview');
    const audio = document.getElementById('audio');
    const pTitle = document.getElementById('p-title');
    const pArtist = document.getElementById('p-artist');
    const pClose = document.getElementById('p-close');
    const storageStatus = document.getElementById('storage-status');
    const clearTts = document.getElementById('clear-tts');
    const clearStitched = document.getElementById('clear-stitched');

    let allSongs = [];
    let allPlaylists = []; // [{key, name, ids, songs, latestAt}]
    let selectedNext = '';

    function esc(s) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, c => ({
        '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
      })[c]);
    }

    function fmtTime(iso) {
      if (!iso) return '—';
      const d = new Date(iso);
      if (isNaN(d)) return '—';
      const pad = n => String(n).padStart(2, '0');
      return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}`;
    }

    function fmtBytes(bytes) {
      if (bytes == null || !Number.isFinite(Number(bytes))) return '—';
      const n = Number(bytes);
      const units = ['B', 'KB', 'MB', 'GB', 'TB'];
      let value = n, i = 0;
      while (value >= 1024 && i < units.length - 1) { value /= 1024; i++; }
      const digits = value >= 100 || i === 0 ? 0 : value >= 10 ? 1 : 2;
      return `${value.toFixed(digits)} ${units[i]}`;
    }

    function fmtDuration(seconds) {
      if (!Number.isFinite(Number(seconds))) return '—';
      const total = Math.max(0, Math.round(Number(seconds)));
      return `${Math.floor(total / 60)}:${String(total % 60).padStart(2, '0')}`;
    }

    function fmtAudioInfo(song) {
      const rate = song.sample_rate_hz ? `${(song.sample_rate_hz / 1000).toFixed(1).replace('.0', '')} kHz` : '频率未知';
      const channels = song.channels ? `${song.channels} 声道${song.channel_mode ? ` · ${song.channel_mode}` : ''}` : '声道未知';
      const bitrate = song.bitrate_kbps ? `${song.bitrate_kbps} kbps` : '码率未知';
      return `<div class="primary">${esc(rate)} · ${esc(channels)}</div>` +
        `<div class="secondary">${esc(bitrate)} · ${esc(fmtDuration(song.duration_seconds))} · ${esc(fmtBytes(song.size_bytes))}</div>`;
    }

    function renderStorage(storage) {
      const s = storage || {};
      document.getElementById('original-size').textContent = fmtBytes(s.original?.bytes);
      document.getElementById('original-count').textContent = `${s.original?.count || 0} 个文件`;
      document.getElementById('tts-size').textContent = fmtBytes(s.tts?.bytes);
      document.getElementById('tts-count').textContent = `${s.tts?.count || 0} 个文件`;
      document.getElementById('stitched-size').textContent = fmtBytes(s.stitched?.bytes);
      document.getElementById('stitched-count').textContent = `${s.stitched?.count || 0} 个文件`;
      document.getElementById('disk-free').textContent = fmtBytes(s.disk?.free_bytes);
      document.getElementById('disk-total').textContent = `总量 ${fmtBytes(s.disk?.total_bytes)}`;
    }

    function fmtRange(from, to) {
      if (!from || !to) return '—';
      const a = new Date(from), b = new Date(to);
      if (isNaN(a) || isNaN(b)) return '—';
      const pad = n => String(n).padStart(2, '0');
      const fd = `${a.getFullYear()}-${pad(a.getMonth()+1)}-${pad(a.getDate())} ${pad(a.getHours())}:${pad(a.getMinutes())}`;
      const td = `${b.getFullYear()}-${pad(b.getMonth()+1)}-${pad(b.getDate())} ${pad(b.getHours())}:${pad(b.getMinutes())}`;
      // Same day → "06-18 22:30 → 23:05"; different → "06-18 22:30 → 06-19 01:10"
      if (a.toDateString() === b.toDateString()) {
        const tShort = `${pad(b.getHours())}:${pad(b.getMinutes())}`;
        return `${fd} → ${tShort}`;
      }
      return `${fd} → ${td}`;
    }

    async function load() {
      contentEl.innerHTML = '<div class="state">加载中…</div>';
      meta.textContent = '加载中…';
      try {
        const r = await fetch('/api/library', { cache: 'no-store' });
        if (!r.ok) throw new Error(`HTTP ${r.status}`);
        const d = await r.json();
        allSongs = d.songs || [];
        allPlaylists = groupByPlaylist(allSongs);
        renderStorage(d.storage);
        render();
        meta.textContent = `${d.total} 首 · ${allPlaylists.length} 个歌单`;
      } catch (e) {
        contentEl.innerHTML = `<div class="state error">加载失败：${esc(e.message)}</div>`;
        meta.textContent = '—';
      }
    }

    // Group songs by playlist_name. Untagged songs (no playlist_name
    // in the index) go to a synthetic "(未分组)" bucket at the end.
    function groupByPlaylist(songs) {
      const buckets = new Map();
      for (const s of songs) {
        const key = s.playlist_name || '(__untagged__)';
        if (!buckets.has(key)) {
          buckets.set(key, {
            key,
            name: s.playlist_name || '未分组',
            untagged: !s.playlist_name,
            ids: s.playlist_id ? [s.playlist_id] : [],
            songs: [],
            latestAt: null,
            earliestAt: null,
          });
        }
        const b = buckets.get(key);
        b.songs.push(s);
        if (!b.latestAt || s.downloaded_at > b.latestAt) b.latestAt = s.downloaded_at;
        if (!b.earliestAt || s.downloaded_at < b.earliestAt) b.earliestAt = s.downloaded_at;
        if (s.playlist_id && !b.ids.includes(s.playlist_id)) b.ids.push(s.playlist_id);
      }
      // Sort each bucket by downloaded_at desc
      for (const b of buckets.values()) {
        b.songs.sort((a, b) => b.downloaded_at.localeCompare(a.downloaded_at));
      }
      // Sort buckets: real playlists first (by latestAt desc), untagged last
      const out = [...buckets.values()];
      out.sort((a, b) => {
        if (a.untagged !== b.untagged) return a.untagged ? 1 : -1;
        return (b.latestAt || '').localeCompare(a.latestAt || '');
      });
      return out;
    }

    function render() {
      if (!allSongs.length) {
        contentEl.innerHTML = '<div class="state">曲库还是空的。让 DJ Agent 跑一次场景后会陆续出现。</div>';
        return;
      }
      const filter = (search.value || '').trim().toLowerCase();

      // Apply filter
      const visiblePlaylists = allPlaylists.map(b => {
        const songs = filter
          ? b.songs.filter(s =>
              (s.title || '').toLowerCase().includes(filter) ||
              (s.artist || '').toLowerCase().includes(filter) ||
              (b.name || '').toLowerCase().includes(filter))
          : b.songs;
        return songs.length ? { ...b, songs } : null;
      }).filter(Boolean);

      if (!visiblePlaylists.length) {
        contentEl.innerHTML = `<div class="state">没有匹配「${esc(filter)}」的歌曲。</div>`;
        return;
      }

      contentEl.innerHTML = visiblePlaylists.map(b => {
        const head = `
          <div class="group-head" role="button" tabindex="0" aria-expanded="false">
            <div class="toggle">▶</div>
            <div class="name ${b.untagged ? 'untagged' : ''}">${esc(b.name)}</div>
            <div class="count">${b.songs.length} 首</div>
            <div class="meta">${esc(fmtRange(b.earliestAt, b.latestAt))}</div>
          </div>
        `;
        const table = `
          <table class="songs">
            <thead>
              <tr>
                <th class="num">#</th>
                <th>歌名</th>
                <th>艺人</th>
                <th>音频信息</th>
                <th class="time">下载时间</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              ${b.songs.map((s, i) => `
                <tr data-song="${esc(s.title + (s.artist ? ` - ${s.artist}` : ''))}">
                  <td class="num">${i + 1}</td>
                  <td class="title">${esc(s.title || s.name)}</td>
                  <td class="artist">${esc(s.artist || '—')}</td>
                  <td class="audio-info">${fmtAudioInfo(s)}</td>
                  <td class="time">${esc(fmtTime(s.downloaded_at))}</td>
                  <td class="act">
                    <button class="play-btn"
                            data-url="${esc(s.play_url)}"
                            data-title="${esc(s.title || s.name)}"
                            data-artist="${esc(s.artist || '')}">▶ 试听</button>
                    <button class="select-btn"
                            data-name="${esc((s.name || '').replace(/\.mp3$/i, ''))}">设为下一首</button>
                  </td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        `;
        return `<div class="group collapsed">${head}${table}</div>`;
      }).join('');

      // Playlist groups start collapsed. Search results expand automatically
      // so filtering never leaves matching songs hidden.
      contentEl.querySelectorAll('.group').forEach(group => {
        const head = group.querySelector('.group-head');
        const setExpanded = expanded => {
          group.classList.toggle('collapsed', !expanded);
          head.setAttribute('aria-expanded', String(expanded));
        };
        if (filter) setExpanded(true);
        head.addEventListener('click', () => setExpanded(group.classList.contains('collapsed')));
        head.addEventListener('keydown', ev => {
          if (ev.key === 'Enter' || ev.key === ' ') {
            ev.preventDefault();
            setExpanded(group.classList.contains('collapsed'));
          }
        });
      });

      // Wire up play buttons
      contentEl.querySelectorAll('.play-btn').forEach(btn => {
        btn.addEventListener('click', (ev) => {
          ev.stopPropagation();
          pTitle.textContent = btn.dataset.title;
          pArtist.textContent = btn.dataset.artist || '—';
          audio.src = btn.dataset.url;
          preview.classList.add('show');
          audio.play().catch(() => {});
        });
      });

      contentEl.querySelectorAll('.select-btn').forEach(btn => {
        if (btn.dataset.name === selectedNext) {
          btn.classList.add('selected');
          btn.textContent = '✓ 下一首';
          btn.closest('tr')?.classList.add('selected');
        }
        btn.addEventListener('click', async ev => {
          ev.stopPropagation();
          btn.disabled = true;
          try {
            const r = await fetch('/api/select-next', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ name: btn.dataset.name }),
            });
            const d = await r.json();
            if (!r.ok || !d.ok) throw new Error(d.error || `HTTP ${r.status}`);
            selectedNext = btn.dataset.name;
            render();
            storageStatus.textContent = `已将「${btn.dataset.name}」设为下一首，设备下次取曲时生效。`;
          } catch (e) {
            storageStatus.textContent = `切换失败：${e.message}`;
            btn.disabled = false;
          }
        });
      });
    }

    pClose.addEventListener('click', () => {
      audio.pause();
      audio.removeAttribute('src');
      audio.load();
      preview.classList.remove('show');
    });

    refresh.addEventListener('click', load);
    search.addEventListener('input', render);

    async function clearGenerated(kind) {
      const label = kind === 'tts' ? 'TTS MP3' : '拼接 MP3';
      const warning = kind === 'stitched'
        ? `确定清空全部${label}吗？当前使用拼接音频的歌单将无法播放，直到重新生成。`
        : `确定清空全部${label}吗？原始歌曲和拼接 MP3 不会删除。`;
      if (!confirm(warning)) return;
      clearTts.disabled = true;
      clearStitched.disabled = true;
      storageStatus.textContent = `正在清理${label}…`;
      try {
        const r = await fetch(`/api/library/generated/${kind}`, { method: 'DELETE' });
        const d = await r.json();
        if (!r.ok) throw new Error(d.error || `HTTP ${r.status}`);
        storageStatus.textContent = `已删除 ${d.deleted} 个${label}，释放 ${fmtBytes(d.bytes)}`;
        await load();
      } catch (e) {
        storageStatus.textContent = `清理失败：${e.message}`;
      } finally {
        clearTts.disabled = false;
        clearStitched.disabled = false;
      }
    }
    clearTts.addEventListener('click', () => clearGenerated('tts'));
    clearStitched.addEventListener('click', () => clearGenerated('stitched'));

    load();
  </script>
</body>
</html>
